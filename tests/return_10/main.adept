
testing :: fn(unused: Void, should: Bool, x, y: Nat) {
    if(should, x, y)
}

main :: fn(): Nat {
    _ := std.println("HERE IS A MeSsAgE:")
    testing(std.println("Hello, world!\nThis is a test...\nGoodbye world!"), true, 10, 11)
}

NINES :: 9999

std :: .{
    testing1: fn(x: Nat) {
        void
    }
    testing2: fn(x, y, z: String) {
        void
    }
    println: fn(message: String) {
        @println(message)
    }
    testing3: fn(x: Bool) {
        void
    }
}

